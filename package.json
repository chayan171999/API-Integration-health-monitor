{
  "name": "api-health-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Watches third-party API changelogs, deprecation pages and status pages, and flags changes that affect what each integration actually uses.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "monitor": "node --disable-warning=ExperimentalWarning monitor/run.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "validate": "node --disable-warning=ExperimentalWarning monitor/validate.ts",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  }
}
